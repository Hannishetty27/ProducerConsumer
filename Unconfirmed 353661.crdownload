import numpy as np
import threading
import time
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
from matplotlib.animation import FuncAnimation, PillowWriter
from matplotlib.patches import Rectangle

N = 100
NUM_THREADS = 3

print("=" * 65)
print("MATRIX MULTIPLICATION USING PYTHON THREADS + NUMPY")
print("=" * 65)
print()
print("Matrix size :", N, "x", N)
print("Number of simultaneous multiplications :", NUM_THREADS)
print("Framework : NumPy (TensorFlow unavailable in this environment)")
print()

np.random.seed(42)

A = []
B = []
C = []

for i in range(3):
    A.append(np.random.uniform(1, 10, size=(N, N)).astype(np.float32))
    B.append(np.random.uniform(1, 10, size=(N, N)).astype(np.float32))
    C.append(np.zeros((N, N), dtype=np.float32))

progress = [0, 0, 0]
thread_lock = threading.Lock()


def matrix_multiply(thread_id):
    matrix_A = A[thread_id]
    matrix_B = B[thread_id]
    matrix_C = C[thread_id]

    with thread_lock:
        print(f"Thread {thread_id + 1} started")
        print(f"Matrix {thread_id + 1}: A{thread_id + 1} x B{thread_id + 1}")

    for i in range(N):
        row_A = matrix_A[i].reshape(-1, 1)
        multiplication = row_A * matrix_B
        row_result = multiplication.sum(axis=0)
        matrix_C[i] = row_result

        progress[thread_id] = i + 1

        if (i + 1) % 10 == 0:
            with thread_lock:
                print(f"Thread {thread_id + 1} : {i + 1}/100 rows completed")

    with thread_lock:
        print(f"Thread {thread_id + 1} FINISHED")


threads = []
for i in range(NUM_THREADS):
    thread = threading.Thread(target=matrix_multiply, args=(i,), name=f"Thread-{i+1}")
    threads.append(thread)

print()
print("=" * 65)
print("STARTING 3 MATRIX MULTIPLICATIONS")
print("=" * 65)
print()

start_time = time.perf_counter()

for thread in threads:
    thread.start()

for thread in threads:
    thread.join()

end_time = time.perf_counter()

print()
print("=" * 65)
print("ALL 3 THREADS COMPLETED")
print("=" * 65)
print("Total execution time :", round(end_time - start_time, 4), "seconds")
print()

for i in range(3):
    print(f"C{i+1} shape =", C[i].shape)

print()
print("=" * 65)
print("VERIFYING RESULTS")
print("=" * 65)
for i in range(3):
    numpy_result = A[i] @ B[i]
    error = np.max(np.abs(C[i] - numpy_result))
    print(f"C{i+1} maximum error :", error)

print()
print("All results verified using NumPy.")
print()

print("=" * 65)
print("CREATING MULTIPLICATION ANIMATION")
print("=" * 65)
print()

A_visual = A[0]
B_visual = B[0]
C_visual = C[0]

fig, axes = plt.subplots(1, 3, figsize=(15, 6))
fig.suptitle(
    "Matrix Multiplication in Action (100x100, 3 Threads + NumPy)",
    fontsize=16,
    fontweight="bold",
)

axA = axes[0]
imA = axA.imshow(A_visual, cmap="Blues", aspect="auto", interpolation="nearest")
axA.set_title("Matrix A", fontsize=14)
axA.set_xticks([])
axA.set_yticks([])

axB = axes[1]
imB = axB.imshow(B_visual, cmap="Greens", aspect="auto", interpolation="nearest")
axB.set_title("Matrix B", fontsize=14)
axB.set_xticks([])
axB.set_yticks([])

axC = axes[2]
imC = axC.imshow(
    np.zeros((N, N)), cmap="Oranges", aspect="auto",
    interpolation="nearest", vmin=0, vmax=np.max(C_visual),
)
axC.set_title("Matrix C (Result)", fontsize=14)
axC.set_xticks([])
axC.set_yticks([])

blue_row = Rectangle((-0.5, -0.5), N, 1, fill=False, linewidth=3)
axA.add_patch(blue_row)

green_column = Rectangle((-0.5, -0.5), 1, N, fill=False, linewidth=3)
axB.add_patch(green_column)

orange_cell = Rectangle((-0.5, -0.5), 1, 1, fill=False, linewidth=3)
axC.add_patch(orange_cell)

TOTAL_CELLS = N * N
FRAME_STEP = 50
TOTAL_FRAMES = (TOTAL_CELLS // FRAME_STEP) + 1


def update(frame):
    cell_number = min(frame * FRAME_STEP, TOTAL_CELLS - 1)

    row = cell_number // N
    column = cell_number % N

    blue_row.set_xy((-0.5, row - 0.5))
    green_column.set_xy((column - 0.5, -0.5))

    current_C = np.zeros((N, N))
    completed_cells = min(cell_number + 1, TOTAL_CELLS)

    flat_result = C_visual.flatten()
    current_C.flat[:completed_cells] = flat_result[:completed_cells]

    imC.set_data(current_C)

    orange_cell.set_xy((column - 0.5, row - 0.5))

    percentage = (completed_cells / TOTAL_CELLS) * 100

    fig.suptitle(
        "Matrix Multiplication in Action (100x100, 3 Threads + NumPy)\n"
        f"Blue Row {row + 1} x Green Column {column + 1} "
        f"-> Orange C[{row + 1},{column + 1}]    "
        f"Progress: {percentage:.1f}%",
        fontsize=15,
        fontweight="bold",
    )

    return (imC, blue_row, green_column, orange_cell)


animation = FuncAnimation(
    fig, update, frames=TOTAL_FRAMES, interval=100, repeat=False, blit=False,
)

plt.tight_layout(rect=[0, 0, 1, 0.90])

output_path = "/mnt/user-data/outputs/matrix_multiplication.gif"
writer = PillowWriter(fps=10)
animation.save(output_path, writer=writer)
plt.close(fig)

print()
print("=" * 65)
print("ANIMATION SAVED AS GIF")
print("=" * 65)
print("Saved to:", output_path)
print()
print("Visual process:")
print()
print("BLUE MATRIX A")
print("      |")
print("Select row")
print("      |")
print("GREEN MATRIX B")
print("      |")
print("Select column")
print("      |")
print("NumPy multiplies corresponding elements")
print("      |")
print("ORANGE MATRIX C")
print("      |")
print("Result cell is generated")
print()
print("A1 x B1 = C1")
print("A2 x B2 = C2")
print("A3 x B3 = C3")
print()
print("Y 3 Python threads completed")
print("Y 100 x 100 matrices used")
print("Y NumPy used for multiplication")
print("Y Blue x Green -> Orange animation")
print("=" * 65)
